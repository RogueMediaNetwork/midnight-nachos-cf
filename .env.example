# Set these in Cloudflare Pages dashboard under Settings > Environment Variables
# Powers the AI concierge (/api/concierge). Without it, the concierge falls back to canned answers.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: lets organizers POST /api/announcements with header `x-admin-key: <this value>`
ADMIN_KEY=pick_a_long_random_string
